# Copy to local.env (git-ignored) on the phone and fill in. NEVER commit
# local.env. All values are optional.
# Private ntfy topic used ONLY as an optional hint/alert channel.
# GitHub (endpoints.json) is the source of truth; the portal does not
# resolve endpoints from ntfy at all (audit C2).
NTFY_TOPIC=
# Tunnel mode: quick (default) or named (see docs/NAMED-TUNNEL.md)
TUNNEL_MODE=quick
# Set to 1 only if you deliberately want sshd started by start_services.sh
START_SSHD=0
